# ==========================================================================
# Pyckle - variables de entorno
# Copia este archivo a .env y rellena los valores. NUNCA lo subas a Git.
#   cp .env.example .env
# Genera SECRET_KEY con:  openssl rand -hex 32
# ==========================================================================

# --- Aplicacion -----------------------------------------------------------
APP_NAME=Pyckle
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-openssl-rand-hex-32
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Origenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost
# Hosts permitidos por TrustedHost (separados por coma).
# En desarrollo agrega los nombres internos (backend,nginx) si pruebas desde contenedores.
TRUSTED_HOSTS=localhost,127.0.0.1,pyckle.example.com
# IP/CIDR de proxies de confianza (separados por coma) de los que se acepta
# X-Real-IP. Fuera de estos rangos el header se ignora y se usa la IP directa.
# En Docker, el rango de la red interna (p. ej. 172.16.0.0/12) cubre a Nginx.
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,127.0.0.1/32,::1/128
# URL publica del frontend (enlaces en correos/notificaciones)
FRONTEND_URL=http://localhost:5173
# Base de la API que consume el frontend (en dev Vite hace proxy de /api)
VITE_API_BASE_URL=/api/v1

# --- JWT ------------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=pyckle
POSTGRES_PASSWORD=replace-strong-db-password
POSTGRES_DB=pyckle
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Usado por Alembic y la app dentro de Docker
DATABASE_URL=postgresql+asyncpg://pyckle:replace-strong-db-password@postgres:5432/pyckle
# Base de datos de tests (si se omite, los tests derivan <POSTGRES_DB>_test)
TEST_DATABASE_URL=postgresql+asyncpg://pyckle:replace-strong-db-password@postgres:5432/pyckle_test
# Pool de conexiones. Maximo de conexiones = workers * (DB_POOL_SIZE + DB_MAX_OVERFLOW).
# Con 2 workers: 2 * (5 + 10) = 30 conexiones como maximo.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Rate limit de login --------------------------------------------------
# 3 intentos fallidos -> bloqueo de 300 segundos (5 minutos), reventana infinita.
LOGIN_MAX_ATTEMPTS=3
LOGIN_BLOCK_SECONDS=300

# --- Rate limit de registro ----------------------------------------------
# Limita altas de cuenta por IP confiable (no por email: es trivial variarlo).
# Independiente del TTL de onboarding OAuth.
REGISTER_MAX_PER_IP=20
REGISTER_WINDOW_SECONDS=3600

# --- Almacenamiento de imagenes ------------------------------------------
# local = volumen Docker (desarrollo/pruebas) | s3 = Supabase Storage (produccion)
# La base de datos guarda solo storage_key; Pyckle sirve las imagenes en /api/v1/media.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/app/media

# Supabase Storage (S3 compatible). Rellena solo si STORAGE_BACKEND=s3
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=pyckle

# --- Subidas --------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=5
MAX_IMAGES_PER_REQUEST=6
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- Seed / administrador inicial ----------------------------------------
# En produccion ADMIN_PASSWORD es obligatoria y fuerte (minimo 12 caracteres);
# el placeholder publico de abajo se rechaza al arrancar.
ADMIN_EMAIL=admin@pyckle.dev
ADMIN_PASSWORD=replace-strong-admin-password
# Solo desarrollo: crea cliente/tecnico/solicitud/cotizacion de ejemplo
SEED_DEMO_DATA=false
DEMO_PASSWORD=replace-demo-password

# --- Google OAuth (server-side) ------------------------------------------
# El frontend NUNCA conoce estas credenciales: solo navega a /api/v1/auth/google.
# Configura en Google Cloud un Authorized redirect URI igual a GOOGLE_REDIRECT_URI.
# Déjalas vacías para deshabilitar el login con Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Ventana maxima (segundos) para completar el registro de una cuenta iniciada
# con Google (one-shot, server-side). No es un rate limit.
OAUTH_ONBOARDING_TTL_SECONDS=120

# --- Despliegue / Cloudflare ---------------------------------------------
# Dominio o subdominio gestionado por Cloudflare (placeholder)
DOMAIN=pyckle.example.com
